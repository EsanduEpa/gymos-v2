generator client {
  provider     = "prisma-client"
  output       = "../../../apps/api/src/generated/tenant"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Member {
  id        String       @id @default(cuid())
  fullName  String
  email     String?      @unique
  status    MemberStatus @default(ACTIVE)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}
