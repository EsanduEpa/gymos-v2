generator client {
  provider     = "prisma-client"
  output       = "../../../apps/api/src/generated/tenant"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum MemberStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum MemberRegistrationState {
  BASIC
  PENDING
  COMPLETE
  FAILED
}

enum TrainerRegistrationState {
  PENDING
  COMPLETE
  FAILED
}

enum TrainerStatus {
  ACTIVE
  DEACTIVATED
}

enum TrainerLevel {
  LEVEL_1
  LEVEL_2
}

model Member {
  id                    String                  @id @default(cuid())
  fullName              String
  email                 String?                 @unique
  status                MemberStatus            @default(ACTIVE)
  identityId            String?                 @unique
  registrationState     MemberRegistrationState @default(BASIC)
  enrollmentOperationId String?                 @unique
  version               Int                     @default(0)
  phone                 String?
  dateOfBirth           DateTime?               @db.Date
  emergencyContact      String?
  healthNotes           String?
  sessionPacks          SessionPack[]
  memberships           MembershipTerm[]
  sessionsAsMember      PTSession[]             @relation("SessionMember")
  workoutPlans          WorkoutPlan[]            @relation("WorkoutPlanMember")
  mealPlans             MealPlan[]               @relation("MealPlanMember")
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
}

enum SessionPackStatus {
  ACTIVE
  EXPIRED
  DEPLETED
}

model SessionPack {
  id                    String            @id @default(cuid())
  memberId              String
  member                Member            @relation(fields: [memberId], references: [id], onDelete: Restrict)
  issuedCredits         Int
  price                 Decimal           @db.Decimal(19, 4)
  currency              String
  totalMinorUnits       BigInt
  creditBaseMinorUnits  BigInt
  creditRemainder       Int
  creditAllocationPolicyVersion String
  validityDays          Int
  startDate             DateTime          @db.Date
  endDateExclusive      DateTime          @db.Date
  status                SessionPackStatus @default(ACTIVE)
  version               Int               @default(0)
  commandReceiptId      String            @unique
  actorIdentityId       String
  idempotencyKey        String
  requestDigest         String
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  creditMovements       PackCreditMovement[]
  holds                 SessionCreditHold[]
  remedies                      PTCreditRemedy[]

  @@unique([actorIdentityId, idempotencyKey])
  @@index([memberId, endDateExclusive, createdAt, id])
}

model Trainer {
  id                    String                   @id @default(cuid())
  fullName              String
  email                 String?                  @unique
  phone                 String?
  level                 TrainerLevel?
  specialisations       String[]                 @default([])
  yearsExperience       Int?
  shiftStart            String?
  shiftEnd              String?
  bio                   String?
  identityId            String?                  @unique
  registrationState     TrainerRegistrationState @default(PENDING)
  enrollmentOperationId String?                  @unique
  status                TrainerStatus            @default(ACTIVE)
  version               Int                      @default(0)
  sessions              PTSession[]              @relation("SessionTrainer")
  availabilityRules     PTAvailabilityRule[]
  workoutPlans          WorkoutPlan[]            @relation("WorkoutPlanTrainer")
  mealPlans             MealPlan[]               @relation("MealPlanTrainer")
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt
}

model WorkoutPlan {
  id          String            @id @default(cuid())
  memberId    String
  member      Member            @relation("WorkoutPlanMember", fields: [memberId], references: [id], onDelete: Restrict)
  trainerId   String
  trainer     Trainer           @relation("WorkoutPlanTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  name        String
  description String?
  createdAt   DateTime          @default(now()) @db.Timestamptz(3)
  exercises   WorkoutExercise[]

  @@index([memberId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([trainerId, createdAt(sort: Desc), id(sort: Desc)])
}

model WorkoutExercise {
  id              String      @id @default(cuid())
  planId          String
  plan            WorkoutPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  sortOrder       Int
  name            String
  sets            Int
  reps            Int?
  weightKg        Decimal?    @db.Decimal(7, 3)
  durationMinutes Int?
  notes           String?

  @@unique([planId, sortOrder])
  @@index([planId, sortOrder])
}

model MealPlan {
  id        String          @id @default(cuid())
  memberId  String
  member    Member          @relation("MealPlanMember", fields: [memberId], references: [id], onDelete: Restrict)
  trainerId String
  trainer   Trainer         @relation("MealPlanTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  name      String
  createdAt DateTime        @default(now()) @db.Timestamptz(3)
  entries   MealPlanEntry[]

  @@index([memberId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([trainerId, createdAt(sort: Desc), id(sort: Desc)])
}

model MealPlanEntry {
  id           String   @id @default(cuid())
  planId       String
  plan         MealPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  sortOrder    Int
  dayOfWeek    Int
  mealType     String
  foodItem     String
  calories     Int?
  proteinGrams Decimal? @db.Decimal(7, 2)
  carbsGrams   Decimal? @db.Decimal(7, 2)
  fatsGrams    Decimal? @db.Decimal(7, 2)

  @@unique([planId, sortOrder])
  @@index([planId, sortOrder])
}

enum PTSessionState {
  PENDING_CONFIRMATION
  SCHEDULED
  ACTIVE
  COMPLETED
  MISSED
  CANCELLED
  DECLINED
  EXPIRED
}

enum SessionType {
  IN_PERSON
  VIRTUAL
  INTRODUCTORY
}

enum SessionCreditHoldState {
  HELD
  CONSUMED
  RELEASED
}

enum PackCreditMovementKind {
  CORRECTION
  ISSUE
  HOLD
  RELEASE
  CONSUME
  EXPIRE
}

enum SessionSettlementKind {
  COMPLETED
  MISSED
  LATE_CANCELLED
  FREE_CANCELLED
  WITHDRAWN
  LIFECYCLE_RELEASE
}

enum OperationalEarningCategory {
  COMPLETED_SESSION
  MISSED_LATE
  LATE_CANCEL
  EXPIRED_UNUSED
  MEMBERSHIP_DAILY
}

enum PTAvailabilityKind {
  WEEKLY_WINDOW
  DATED_WINDOW
  BLOCK
  GYM_CLOSURE
}

model PTAvailabilityRule {
  id                    String             @id @default(cuid())
  trainerId             String?
  trainer               Trainer?           @relation(fields: [trainerId], references: [id], onDelete: Restrict)
  kind                  PTAvailabilityKind
  weekday               Int?
  localDate             DateTime?          @db.Date
  startMinute           Int?
  endMinute             Int?
  effectiveFrom         DateTime?          @db.Date
  effectiveToExclusive  DateTime?          @db.Date
  reason                String?
  version               Int                @default(0)
  createdByIdentityId   String
  commandReceiptId      String
  commandReceipt        CommandReceipt     @relation(fields: [commandReceiptId], references: [id], onDelete: Restrict)
  createdAt             DateTime           @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime           @updatedAt @db.Timestamptz(3)

  @@index([commandReceiptId])
  @@index([trainerId, kind, weekday, effectiveFrom])
  @@index([trainerId, localDate, kind])
  @@index([localDate, kind])
}

model PTSession {
  id                    String          @id @default(cuid())
  memberId              String
  member                Member          @relation("SessionMember", fields: [memberId], references: [id], onDelete: Restrict)
  trainerId             String
  trainer               Trainer         @relation("SessionTrainer", fields: [trainerId], references: [id], onDelete: Restrict)
  state                 PTSessionState  @default(PENDING_CONFIRMATION)
  version               Int             @default(0)
  type                  SessionType     @default(IN_PERSON)
  scheduledStartAt      DateTime        @db.Timestamptz(3)
  scheduledEndAt        DateTime        @db.Timestamptz(3)
  gymTimezone           String
  fee                   Decimal         @db.Decimal(19, 4)
  currency              String
  confirmationRate      Decimal?        @db.Decimal(9, 6)
  confirmationLevel     TrainerLevel?
  confirmationShiftStart String?
  confirmationShiftEnd String?
  configurationVersion  Int
  confirmedAt           DateTime?       @db.Timestamptz(3)
  requestExpiresAt      DateTime?       @db.Timestamptz(3)
  availabilityVersion   Int?
  startedAt             DateTime?       @db.Timestamptz(3)
  endedAt               DateTime?       @db.Timestamptz(3)
  notes                 String?
  declineReason         String?
  createdByIdentityId   String
  updatedAt             DateTime        @updatedAt @db.Timestamptz(3)
  createdAt             DateTime        @default(now()) @db.Timestamptz(3)
  stateEvents           SessionStateEvent[]
  creditHold            SessionCreditHold?
  settlement            SessionSettlement?
  revenueRecords        RevenueRecord[]
  payRecord             PayRecord?
  payCorrections         TrainerPayCorrection[]
  reminders              PTSessionReminder[]
  adjustments            PTSessionAdjustment[]  @relation("AdjustedSession")
  replacementAdjustment  PTSessionAdjustment?   @relation("ReplacementSession")

  @@index([memberId, scheduledStartAt, id])
  @@index([trainerId, scheduledStartAt, id])
  @@index([state, scheduledStartAt, id])
  @@index([state, requestExpiresAt, id])
}

model SessionStateEvent {
  id                  String          @id @default(cuid())
  sessionId           String
  session             PTSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  fromState           PTSessionState?
  toState             PTSessionState
  committedVersion    Int
  actorIdentityId     String
  receiptId           String
  receipt             CommandReceipt   @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  eventKey            String          @unique
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)

  adjustments PTSessionAdjustment[]

  @@unique([sessionId, committedVersion])
  @@index([sessionId, createdAt, id])
}

model SessionCreditHold {
  id                  String                 @id @default(cuid())
  sessionId           String                 @unique
  session             PTSession              @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  packId              String
  pack                SessionPack            @relation(fields: [packId], references: [id], onDelete: Restrict)
  state               SessionCreditHoldState @default(HELD)
  creditOrdinal       Int
  creditValueMinorUnits BigInt
  heldAt              DateTime               @default(now()) @db.Timestamptz(3)
  resolvedAt          DateTime?              @db.Timestamptz(3)
  version             Int                    @default(0)
  movements           PackCreditMovement[]
  remedies              PTCreditRemedy[]

  @@index([packId, state, heldAt, id])
}

model PackCreditMovement {
  id                  String                @id @default(cuid())
  packId              String
  pack                SessionPack           @relation(fields: [packId], references: [id], onDelete: Restrict)
  holdId              String?
  hold                SessionCreditHold?    @relation(fields: [holdId], references: [id], onDelete: Restrict)
  adjustmentId    String?
  adjustment      PTSessionAdjustment?   @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  kind                PackCreditMovementKind
  availableDelta      Int
  heldDelta           Int
  consumedDelta       Int
  expiredDelta        Int
  creditOrdinal       Int?
  sourceKey           String                @unique
  receiptId           String
  receipt             CommandReceipt        @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  actorIdentityId     String
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)

  @@index([packId, creditOrdinal])
  @@index([packId, createdAt, id])
}

model SessionSettlement {
  id                  String                @id @default(cuid())
  sessionId           String                @unique
  session             PTSession             @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  kind                SessionSettlementKind
  creditConsumed      Boolean
  creditValue         Decimal               @db.Decimal(19, 4)
  currency            String
  sourceReceiptId     String
  sourceReceipt       CommandReceipt @relation(fields: [sourceReceiptId], references: [id], onDelete: Restrict)
  createdAt           DateTime              @default(now()) @db.Timestamptz(3)
}

model RevenueRecord {
  id                  String          @id @default(cuid())
  sessionId           String
  session             PTSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  payCorrections      TrainerPayCorrection[]
  reversesId     String?                    @unique
  reverses       RevenueRecord?             @relation("RevenueReversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal       RevenueRecord?             @relation("RevenueReversal")
  category            OperationalEarningCategory
  amount              Decimal         @db.Decimal(19, 4)
  currency            String
  sourceKey           String          @unique
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)

  @@index([category, createdAt, id])
}

enum PayPeriodState {
  OPEN
  CLOSED
  APPROVED
}

model TrainerPayPeriod {
  id                  String          @id @default(cuid())
  cadence             PayPeriod
  localStartDate      DateTime        @db.Date
  localEndDateExclusive DateTime      @db.Date
  timezone            String
  utcStartAt          DateTime        @db.Timestamptz(3)
  utcEndAt            DateTime        @db.Timestamptz(3)
  state               PayPeriodState  @default(OPEN)
  version             Int             @default(0)
  calculatedTotal     Decimal         @default(0) @db.Decimal(19, 4)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime        @updatedAt @db.Timestamptz(3)
  records             PayRecord[]
  corrections         TrainerPayCorrection[] @relation("CorrectionPeriod")
  sourcedCorrections  TrainerPayCorrection[] @relation("CorrectionSourcePeriod")
  approvedAt          DateTime?       @db.Timestamptz(3)
  approvedByIdentityId String?

  @@unique([cadence, localStartDate])
  @@index([state, utcStartAt, id])
}

model PayRecord {
  id                  String          @id @default(cuid())
  sessionId           String          @unique
  session             PTSession       @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  periodId            String
  period              TrainerPayPeriod @relation(fields: [periodId], references: [id], onDelete: Restrict)
  amount              Decimal         @db.Decimal(19, 4)
  currency            String
  sourceKey           String          @unique
  confirmationRate   Decimal          @db.Decimal(9, 6)
  confirmationLevel  TrainerLevel
  createdAt           DateTime         @default(now()) @db.Timestamptz(3)

  @@index([periodId, createdAt, id])
}

model TrainerPayCorrection {
  id                             String           @id @default(cuid())
  sessionId                        String
  session                        PTSession        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  originalPeriodId               String
  originalPeriod                 TrainerPayPeriod @relation("CorrectionSourcePeriod", fields: [originalPeriodId], references: [id], onDelete: Restrict)
  originalEarningId               String
  originalEarning                 RevenueRecord    @relation(fields: [originalEarningId], references: [id], onDelete: Restrict)
  correctionPeriodId             String
  correctionPeriod                TrainerPayPeriod @relation("CorrectionPeriod", fields: [correctionPeriodId], references: [id], onDelete: Restrict)
  amount                         Decimal          @db.Decimal(19, 4)
  currency                       String
  reason                         String
  actorIdentityId                String
  sourcePeriodState              PayPeriodState
  sourcePeriodVersion            Int
  sourcePeriodApprovedAt         DateTime?        @db.Timestamptz(3)
  sourcePeriodApprovedByIdentityId String?
  sourceKey                      String           @unique
  createdAt                      DateTime         @default(now()) @db.Timestamptz(3)

  @@index([sessionId])
  @@index([correctionPeriodId, createdAt, id])
}

model PTSessionAdjustment {
  id                      String                 @id @default(cuid())
  sessionId               String
  session                 PTSession              @relation("AdjustedSession", fields: [sessionId], references: [id], onDelete: Restrict)
  replacementSessionId    String?                @unique
  replacementSession      PTSession?             @relation("ReplacementSession", fields: [replacementSessionId], references: [id], onDelete: Restrict)
  receiptId               String                 @unique
  receipt                 CommandReceipt         @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  sourceEventId           String?
  sourceEvent             SessionStateEvent?     @relation(fields: [sourceEventId], references: [id], onDelete: Restrict)
  kind                    String
  initiatedBy             String
  reason                  String
  actorIdentityId         String
  committedVersion        Int
  fromState               PTSessionState
  toState                 PTSessionState
  effectiveSettlementKind SessionSettlementKind?
  creditConsumed          Boolean?
  previousStartedAt       DateTime?              @db.Timestamptz(3)
  previousEndedAt         DateTime?              @db.Timestamptz(3)
  actualStartedAt         DateTime?              @db.Timestamptz(3)
  actualEndedAt           DateTime?              @db.Timestamptz(3)
  createdAt               DateTime               @default(now()) @db.Timestamptz(3)
  movements               PackCreditMovement[]
  remedy                  PTCreditRemedy?

  @@unique([sessionId, committedVersion])
  @@index([sessionId, createdAt, id])
}

model PTCreditRemedy {
  id                       String              @id @default(cuid())
  adjustmentId             String              @unique
  adjustment               PTSessionAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Restrict)
  sourceHoldId             String              @unique
  sourceHold               SessionCreditHold   @relation(fields: [sourceHoldId], references: [id], onDelete: Restrict)
  packId                   String
  pack                     SessionPack         @relation(fields: [packId], references: [id], onDelete: Restrict)
  creditOrdinal            Int
  originalEndDateExclusive DateTime            @db.Date
  newEndDateExclusive      DateTime            @db.Date
  valueMinorUnits          BigInt
  createdAt                DateTime            @default(now()) @db.Timestamptz(3)

  @@index([packId, creditOrdinal, newEndDateExclusive])
}

enum NotificationLinkKind {
  OWNER_SESSIONS
  TRAINER_SCHEDULE
  MEMBER_SESSIONS
  TRAINER_REQUESTS
  MEMBER_PROFILE
}

model Notification {
  id                  String          @id @default(cuid())
  recipientIdentityId String
  sourceEventKey      String
  supersededAt        DateTime?       @db.Timestamptz(3)
  reminder            PTSessionReminder?
  eventCode           String
  title               String
  message             String
  linkKind            NotificationLinkKind
  resourceId          String?
  readAt              DateTime?       @db.Timestamptz(3)
  createdAt           DateTime        @default(now()) @db.Timestamptz(3)

  @@unique([recipientIdentityId, sourceEventKey])
  @@index([recipientIdentityId, readAt, createdAt, id])
}

enum CommandReceiptState {
  RUNNING
  COMMITTED
  REJECTED
}

enum SchemaVerificationState {
  APPLYING
  VERIFIED
  FAILED
  REPAIR_REQUIRED
}

// Physical database binding. Operational policy/config fields are added by
// their owning migration tasks; schema version is deliberately separate.
model GymConfiguration {
  id          String   @id
  masterGymId String   @unique
  currency    String?
  timezone    String?
  address     String   @default("")
  phone       String?
  email       String?
  payPeriod   PayPeriod @default(MONTHLY)
  defaultSessionFee Decimal @default(50) @db.Decimal(19, 4)
  level2SessionFee Decimal? @db.Decimal(19, 4)
  introSessionFee Decimal? @db.Decimal(19, 4)
  level1BaseRate Decimal @default(0.4) @db.Decimal(9, 6)
  level2BaseRate Decimal @default(0.5) @db.Decimal(9, 6)
  offShiftPremium Decimal @default(0.1) @db.Decimal(9, 6)
  cancellationWindowMinutes Int @default(1440)
  lateCancelDeduction Boolean @default(true)
  minimumSessionDurationMinutes Int @default(20)
  version     Int      @default(0)
  policyVersions GymConfigurationVersion[]
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)
}

model GymConfigurationVersion {
  id String @id @default(cuid())
  gymConfigurationId String
  gymConfiguration GymConfiguration @relation(fields: [gymConfigurationId], references: [id], onDelete: Restrict)
  configurationVersion Int
  currency String?
  timezone String?
  address String
  phone String?
  email String?
  payPeriod PayPeriod
  defaultSessionFee Decimal @db.Decimal(19, 4)
  level2SessionFee Decimal? @db.Decimal(19, 4)
  introSessionFee Decimal? @db.Decimal(19, 4)
  level1BaseRate Decimal @db.Decimal(9, 6)
  level2BaseRate Decimal @db.Decimal(9, 6)
  offShiftPremium Decimal @db.Decimal(9, 6)
  cancellationWindowMinutes Int
  lateCancelDeduction Boolean
  minimumSessionDurationMinutes Int
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  @@unique([gymConfigurationId, configurationVersion])
  @@index([configurationVersion])
}

enum PayPeriod {
  WEEKLY
  MONTHLY
}

enum MembershipPlanStatus {
  ACTIVE
  INACTIVE
}

model MembershipPlan {
  id           String @id @default(cuid())
  name         String
  description  String?
  price        Decimal @db.Decimal(19, 4)
  currency     String
  durationDays Int
  status       MembershipPlanStatus @default(ACTIVE)
  version      Int @default(0)
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  memberships  MembershipTerm[]

  @@index([status, createdAt])
}

model MembershipTerm {
  id                    String @id @default(cuid())
  memberId              String
  member                Member @relation(fields: [memberId], references: [id], onDelete: Restrict)
  planId                String
  plan                  MembershipPlan @relation(fields: [planId], references: [id], onDelete: Restrict)
  startDate             DateTime @db.Date
  endDateExclusive      DateTime @db.Date
  agreedPrice           Decimal @db.Decimal(19, 4)
  currency              String
  planNameSnapshot      String
  configurationVersion  Int
  actorIdentityId       String
  idempotencyKey        String
  requestDigest         String
  createdAt             DateTime @default(now()) @db.Timestamptz(3)

  @@unique([actorIdentityId, idempotencyKey])
  @@index([memberId, startDate, endDateExclusive])
}

model SchemaState {
  id                     String                  @id
  state                  SchemaVerificationState @default(APPLYING)
  appliedTemplateVersion String?
  appliedManifestDigest  String?
  schemaEvidenceDigest   String?
  verifiedMigrations     Json                    @default("[]")
  appliedAt              DateTime?               @db.Timestamptz(3)
  verifiedAt             DateTime?               @db.Timestamptz(3)
  lastOperationId        String?
  version                Int                     @default(0)
  updatedAt              DateTime                @updatedAt @db.Timestamptz(3)
}

model CommandReceipt {
  id                      String              @id @default(cuid())
  actorIdentityId         String // External Master identity, no FK.
  commandKind             String
  idempotencyKey          String
  requestDigest           String
  resourceType            String?
  resourceId              String?
  sourceMasterOperationId String?             @unique // External Master operation, no FK.
  state                   CommandReceiptState @default(RUNNING)
  safeResult              Json?
  createdAt               DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime            @updatedAt @db.Timestamptz(3)
  committedAt             DateTime?           @db.Timestamptz(3)
  audits                  AuditLog[]
  sessionEvents           SessionStateEvent[]
  availabilityRules       PTAvailabilityRule[]
  settlements             SessionSettlement[]
  packCreditMovements     PackCreditMovement[]
  expenses                ExpenseRecord[]
  budgets                 CategoryBudget[]
  ptAdjustments           PTSessionAdjustment[]

  @@unique([actorIdentityId, commandKind, idempotencyKey])
  @@index([state, createdAt])
}

model AuditLog {
  id                      String         @id @default(cuid())
  eventKey                String         @unique
  contentDigest           String
  receiptId               String
  receipt                 CommandReceipt @relation(fields: [receiptId], references: [id], onDelete: Restrict)
  actorIdentityId         String // External Master reference, no FK.
  originalActorIdentityId String?
  eventCode               String
  resourceType            String
  resourceId              String
  transition              Json
  createdAt               DateTime       @default(now()) @db.Timestamptz(3)

  @@index([createdAt, id])
  @@index([actorIdentityId, createdAt])
}

enum ExpenseCategory {
  RENT
  UTILITIES
  EQUIPMENT
  MARKETING
  SALARIES
  MAINTENANCE
  OTHER
}

model ExpenseRecord {
  id                String @id @default(cuid())
  category          ExpenseCategory
  amount            Decimal @db.Decimal(19, 4)
  currency          String
  accountingDate    DateTime @db.Date
  description       String?
  recurring         Boolean @default(false)
  version           Int @default(0)
  commandReceiptId  String @unique
  commandReceipt    CommandReceipt @relation(fields: [commandReceiptId], references: [id], onDelete: Restrict)
  createdByIdentityId String
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@index([accountingDate, category, id])
  @@index([category, accountingDate, id])
}

model CategoryBudget {
  id               String @id @default(cuid())
  category         ExpenseCategory
  month            DateTime @db.Date
  amount           Decimal @db.Decimal(19, 4)
  currency         String
  version          Int @default(0)
  commandReceiptId String @unique
  commandReceipt   CommandReceipt @relation(fields: [commandReceiptId], references: [id], onDelete: Restrict)
  actorIdentityId  String
  createdAt        DateTime @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime @updatedAt @db.Timestamptz(3)

  @@unique([category, month])
  @@index([month, category])
}

model PTSessionReminder {
  id String @id
  sessionId String
  session PTSession @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  scheduledStartAt DateTime @db.Timestamptz(3)
  scheduledEndAt DateTime @db.Timestamptz(3)
  kind String
  recipientIdentityId String
  recipientRole String
  dueAt DateTime @db.Timestamptz(3)
  status String @default("PENDING")
  attempts Int @default(0)
  nextAttemptAt DateTime @db.Timestamptz(3)
  finishedAt DateTime? @db.Timestamptz(3)
  notificationId String? @unique
  notification Notification? @relation(fields: [notificationId], references: [id], onDelete: Restrict)
  lastError String?
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  @@unique([sessionId, scheduledStartAt, scheduledEndAt, kind, recipientIdentityId], map: "PTSessionReminder_revision_key")
  @@index([status, nextAttemptAt, dueAt, id], map: "PTSessionReminder_due_idx")
}
model PTScheduledWorkStatus {
  id String @id
  lastAttemptAt DateTime @db.Timestamptz(3)
  lastSuccessAt DateTime? @db.Timestamptz(3)
  totalFailures Int @default(0)
  lastError String?
}
