# Enter these in the hosting dashboards; never commit real credentials.
NODE_ENV=production
GYMOS_WEB_ORIGIN=https://your-web-project.vercel.app
GYMOS_API_URL=https://your-api-service.onrender.com
GYMOS_DEPLOY_DATABASE_HOST=db.yourprojectref.supabase.co
# Dedicated database created explicitly before migration. Do not use /postgres here.
MASTER_DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.yourprojectref.supabase.co:5432/gymos_master?sslmode=verify-full
TENANT_DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.yourprojectref.supabase.co:5432/postgres?sslmode=verify-full
PROVISION_DATABASE_URL=postgresql://postgres:URL_ENCODED_PASSWORD@db.yourprojectref.supabase.co:5432/postgres?sslmode=verify-full
JWT_SECRET=replace-with-a-new-random-secret-at-least-32-characters
PROVISIONING_RUNNER_ENABLED=true
PT_EXPIRY_RUNNER_ENABLED=true
# If required by the project's certificate chain, upload the public Supabase CA
# as a Render secret file and set NODE_EXTRA_CA_CERTS to its absolute path.
# NODE_EXTRA_CA_CERTS=/etc/secrets/supabase-ca.crt
