# Copy to ignored .env.deploy.neon; replace every example value privately.
NODE_ENV=production
GYMOS_WEB_ORIGIN=https://your-project.vercel.app
GYMOS_API_URL=https://your-api.onrender.com
GYMOS_DEPLOY_DATABASE_HOST=ep-your-endpoint.us-east-2.aws.neon.tech
MASTER_DATABASE_URL=postgresql://neondb_owner:URL_ENCODED_PASSWORD@ep-your-endpoint.us-east-2.aws.neon.tech:5432/gymos_master?sslmode=verify-full
TENANT_DATABASE_URL=postgresql://neondb_owner:URL_ENCODED_PASSWORD@ep-your-endpoint.us-east-2.aws.neon.tech:5432/gymos_master?sslmode=verify-full
PROVISION_DATABASE_URL=postgresql://neondb_owner:URL_ENCODED_PASSWORD@ep-your-endpoint.us-east-2.aws.neon.tech:5432/gymos_master?sslmode=verify-full
JWT_SECRET=replace-with-a-new-random-secret-at-least-32-characters
PROVISIONING_RUNNER_ENABLED=true
PT_EXPIRY_RUNNER_ENABLED=true
